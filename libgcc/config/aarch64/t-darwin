# Ensure we have a suitable minimum OS version.

HOST_LIBGCC2_CFLAGS += -mmacosx-version-min=11.0

LIB2_SIDITI_CONV_FUNCS = yes

# The unwinder comes from libSystem, and for the supported OS versions the
# driver does not link libgcc_eh.a (see REAL_LIBGCC_SPEC in darwin.h), so
# omit the unwinder sources.  Later fragments add the SME runtime to
# LIB2ADDEH; those objects are still needed for libsme_rt.a.
LIB2ADDEH := $(filter-out %/unwind-dw2.c %/unwind-dw2-fde-darwin.c \
	       %/unwind-c.c,$(LIB2ADDEH))
